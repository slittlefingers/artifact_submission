+LiteRtStatus LiteRtDispatchDeviceContextT::LoadExecutable(

+    LiteRtDispatchExecutableType type, const LiteRtMemBuffer& bytecode_buffer,

+    LiteRtDispatchExecutableHandle& exec_handle) {

+  ThrSqContainerType thr_type;

+  switch (type) {

+    case kLiteRtDispatchExecutableTypeDspLibrary:

+      thr_type = kThrSqContainerTypeFunctionLibrary;

+      break;

+    case kLiteRtDispatchExecutableTypeMlModel:

+      thr_type = kThrSqContainerTypeMlModel;

+      break;

+    case kLiteRtDispatchExecutableTypeTfliteModel:

+      thr_type = kThrSqContainerTypeTflite;

+      break;

+    default:

+      LITERT_LOG(LITERT_ERROR, "Invalid executable type %d", type);

+      return kLiteRtStatusErrorInvalidArgument;

+  }

+

+  // LiteRT-LM passes mmap-backed model sections through its buffer API,

+  // losing the original file descriptor. Recover a validated file view instead

+  // of copying a multi-GB SQ container for each signature. Keep this opt-in.

+  if (bytecode_buffer.fd < 0 && bytecode_buffer.base_addr &&

+      std::getenv("GHOST_LAZY_NPU_LOAD") != nullptr) {

+    const uintptr_t begin = reinterpret_cast<uintptr_t>(bytecode_buffer.base_addr) +

+                            bytecode_buffer.offset;

+    FILE* maps = std::fopen("/proc/self/maps", "r");

+    if (maps) {

+      char line[4096];

+      while (std::fgets(line, sizeof(line), maps)) {

+        unsigned long low, high, offset, inode;

+        unsigned int major, minor;

+        char prot[5]; int path_start = 0;

+        if (std::sscanf(line, "%lx-%lx %4s %lx %x:%x %lu %n", &low, &high,

+                        prot, &offset, &major, &minor, &inode, &path_start) != 7 ||

+            begin < low || begin >= high || bytecode_buffer.size > high - begin)

+          continue;

+        std::string path(line + path_start);

+        while (!path.empty() && (path.back() == '\n' || path.back() == '\r')) path.pop_back();

+        if (path.empty() || path.front() != '/' || path.find(" (deleted)") != std::string::npos) continue;

+        auto it = mapped_model_fds_.find(path);

+        if (it == mapped_model_fds_.end()) {

+          int fd = open(path.c_str(), O_RDONLY | O_CLOEXEC);

+          if (fd < 0) continue;

+          it = mapped_model_fds_.try_emplace(path, fd).first;

+        }

+        const size_t file_offset = offset + (begin - low);

+        struct stat st;

+        if (fstat(it->second, &st) || static_cast<unsigned long>(st.st_ino) != inode ||

+            file_offset > static_cast<size_t>(st.st_size) ||

+            bytecode_buffer.size > static_cast<size_t>(st.st_size) - file_offset) continue;

+        LiteRtMemBuffer file_view = bytecode_buffer;

+        file_view.fd = it->second;

+        file_view.alloc_base_file_offset = file_offset;

+        file_view.offset = 0;

+        std::fclose(maps);

+        LITERT_LOG(LITERT_INFO, "Recovered NPU file view: fd=%d offset=%zu bytes=%zu",

+                   file_view.fd, file_offset, file_view.size);

+        return LoadExecutable(type, file_view, exec_handle);

+      }

+      std::fclose(maps);

+    }

+  }

+

+  LITERT_LOG(LITERT_INFO,

+             "Ghost NPU program: fd=%d bytes=%zu allocation_file_offset=%zu offset=%zu lazy=%d",

+             bytecode_buffer.fd, bytecode_buffer.size,

+             bytecode_buffer.alloc_base_file_offset, bytecode_buffer.offset,

+             std::getenv("GHOST_LAZY_NPU_LOAD") != nullptr);

+  if (bytecode_buffer.fd >= 0) {

+    size_t offset =

+        bytecode_buffer.alloc_base_file_offset + bytecode_buffer.offset;

+    ExecutableFileCacheKey cache_key{bytecode_buffer.fd, bytecode_buffer.size,

+                                     offset};

+

+    if (auto it = cache_key_to_exec_data_.find(cache_key);

+        it != cache_key_to_exec_data_.end()) {

+      LITERT_LOG(LITERT_INFO,

+                 "Executable file cache hit: fd=%d, size=%zu, offset=%zu",

+                 bytecode_buffer.fd, bytecode_buffer.size, offset);

+

+      it->second.ref_count++;

+      exec_handle = it->second.handle;

+      return kLiteRtStatusOk;

+    }

+

+    if (GoogleTensorSouthBoundFeatureSupported(

+            GoogleTensorSouthBoundFeature::kSqContainerFdWithOffset)) {

+      GT_LOG_RETURN_IF_SB_ERROR(

+          thrLoadSqContainerFdWithOffset(

+              thr_context_, thr_type, bytecode_buffer.fd, bytecode_buffer.size,

+              offset, /*lazy_loading=*/(std::getenv("GHOST_LAZY_NPU_LOAD") != nullptr), &exec_handle),

+          "Failed to load SQ container from FD with offset");

+

+      if (IsTflite(bytecode_buffer.fd, offset)) {

+        tflite_executables_.insert(exec_handle);

+      }

+

+      cache_key_to_exec_data_.try_emplace(cache_key, exec_handle);

+      return kLiteRtStatusOk;

+    }

+

+    // Old SouthBound, offset == 0: legacy FD entry point handles it directly.

+    if (offset == 0) {

+      GT_LOG_RETURN_IF_SB_ERROR(

+          thrLoadSqContainerFd(thr_context_, thr_type, bytecode_buffer.fd,

+                               bytecode_buffer.size, /*lazy_loading=*/(std::getenv("GHOST_LAZY_NPU_LOAD") != nullptr),

+                               &exec_handle),

+          "Failed to load SQ container from FD");

+

+      if (IsTflite(bytecode_buffer.fd, 0)) {

+        tflite_executables_.insert(exec_handle);

+      }

+

+      cache_key_to_exec_data_.try_emplace(cache_key, exec_handle);

+      return kLiteRtStatusOk;

+    }

+

+    // Old SouthBound, offset > 0 (e.g. AOT .tflite with embedded DISPATCH_OP):

+    // mmap a page-aligned region and load via the pointer-based API.

+    const size_t page_size = static_cast<size_t>(sysconf(_SC_PAGESIZE));

+    const size_t aligned_offset = offset & ~(page_size - 1);

+    const size_t offset_delta = offset - aligned_offset;

+    const size_t map_length = bytecode_buffer.size + offset_delta;

+    void* mapped = mmap(nullptr, map_length, PROT_READ, MAP_PRIVATE,

+                        bytecode_buffer.fd, static_cast<off_t>(aligned_offset));

+    if (mapped == MAP_FAILED) {

+      LITERT_LOG(LITERT_ERROR,

+                 "Failed to mmap SQ bytecode (fd=%d, size=%zu, offset=%zu)",

+                 bytecode_buffer.fd, bytecode_buffer.size, offset);

+      return kLiteRtStatusErrorRuntimeFailure;

+    }

+    absl::Cleanup mmap_cleanup = [mapped, map_length] {

+      munmap(mapped, map_length);

+    };

+

+    const void* bytecode_ptr =

+        static_cast<const std::byte*>(mapped) + offset_delta;

+    GT_LOG_RETURN_IF_SB_ERROR(

+        thrLoadSqContainer(thr_context_, thr_type, bytecode_ptr,

+                           bytecode_buffer.size, &exec_handle),

+        "Failed to load SQ container from mmap'd buffer");

+

+    if (IsTflite(bytecode_ptr, bytecode_buffer.size)) {

+      tflite_executables_.insert(exec_handle);

+    }

+

+    mmap_regions_.push_back({exec_handle, mapped, map_length});

+    std::move(mmap_cleanup).Cancel();

+

+    cache_key_to_exec_data_.try_emplace(cache_key, exec_handle);

+    return kLiteRtStatusOk;

+  } else {

+    const auto* sq_bytecode =

+        static_cast<const std::byte*>(bytecode_buffer.base_addr) +

+        bytecode_buffer.offset;

+

+    GT_LOG_RETURN_IF_SB_ERROR(

+        thrLoadSqContainer(thr_context_, thr_type, sq_bytecode,

+                           bytecode_buffer.size, &exec_handle),

+        "Failed to load SQ container from buffer with base 0x%p and size %zu",

+        sq_bytecode, bytecode_buffer.size);

+

+    if (IsTflite(sq_bytecode, bytecode_buffer.size)) {

+      tflite_executables_.insert(exec_handle);

+    }

+  }

+

+  return kLiteRtStatusOk;

+}

+

+bool LiteRtDispatchDeviceContextT::IsTfliteExecutable(

+    LiteRtDispatchExecutableHandle exec_handle) const {

+  return tflite_executables_.contains(exec_handle);

+}

+

+LiteRtStatus LiteRtDispatchDeviceContextT::UnloadExecutable(

+    LiteRtDispatchExecutableHandle exec_handle) {

+  for (auto it = cache_key_to_exec_data_.begin();

+       it != cache_key_to_exec_data_.end(); ++it) {

+    if (it->second.handle == exec_handle) {

+      if (--(it->second.ref_count) > 0) {

+        return kLiteRtStatusOk;

+      }

+

+      cache_key_to_exec_data_.erase(it);

+      break;

+    }

+  }

+

+  GT_LOG_RETURN_IF_SB_ERROR(thrUnloadSqContainer(thr_context_, exec_handle),

+                            "Failed to unload SQ container %" PRIu64,

+                            exec_handle);

+

+  tflite_executables_.erase(exec_handle);

+

+  // Release any mmap'd region associated with this executable.

+  for (auto it = mmap_regions_.begin(); it != mmap_regions_.end(); ++it) {

+    if (it->exec_handle == exec_handle) {

+      munmap(it->addr, it->length);

+      mmap_regions_.erase(it);

+      break;

+    }

+  }

+

+  return kLiteRtStatusOk;

+}

+

+LiteRtStatus LiteRtDispatchDeviceContextT::RegisterGraph(

+    LiteRtDispatchGraph graph) {

+  if (auto [_, inserted] = registered_graphs_.insert(graph); !inserted) {

+    LITERT_LOG(LITERT_ERROR, "Graph 0x%p is already registered", graph);

+    return kLiteRtStatusErrorInvalidArgument;

+  }

+

+  return kLiteRtStatusOk;

+}

+

+LiteRtStatus LiteRtDispatchDeviceContextT::UnregisterGraph(

+    LiteRtDispatchGraph graph) {

+  if (registered_graphs_.erase(graph) == 0) {

+    LITERT_LOG(LITERT_ERROR, "Graph 0x%p was not previously registered", graph);

+    return kLiteRtStatusErrorInvalidArgument;

+  }

+

+  return kLiteRtStatusOk;

+}

+

+LiteRtStatus LiteRtDispatchDeviceContextT::AnnotateSystemAttribute(

+    const char* absl_nonnull key, const char* absl_nonnull value) {

+  GT_LOG_RETURN_IF_SB_ERROR(

+      thrVendorSetSystemAttributeStr(thr_context_, key, value),

+      "Failed to set system attribute %s to %s", key, value);

+  return kLiteRtStatusOk;

+}

+

+void LiteRtDispatchDeviceContextT::SetVendorHook(LiteRtHook hook) {

+  vendor_hook_ = hook;

+}

+

+LiteRtHook LiteRtDispatchDeviceContextT::GetVendorHook() const {

+  return vendor_hook_;

+}

+

+void LiteRtDispatchDeviceContextT::SetVendorHookUserData(void* data) {

+  vendor_hook_user_data_ = data;

+}

+

+void* LiteRtDispatchDeviceContextT::GetVendorHookUserData() const {

+  return vendor_hook_user_data_;

+}

