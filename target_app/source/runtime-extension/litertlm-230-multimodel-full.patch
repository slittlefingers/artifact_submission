+// App-specific C entry point: preprocess only this turn, then use the existing
+// Session. No Conversation, transcript list, checkpoints or prompt replay.
+extern "C" LITERT_LM_C_API_EXPORT LiteRtLmResponses*
+ghost_session_generate_multimodal(LiteRtLmEngine* engine, LiteRtLmSession* session,
+                                  const char* text, const char* image_path,
+                                  const char* audio_path) {
+  using namespace litert::lm;
+  auto error = [](const absl::Status& status) -> LiteRtLmResponses* {
+    litert::lm::c::SetLastError(status);
+    return nullptr;
+  };
+  if (!engine || !engine->engine || !session || !session->session || !text)
+    return error(absl::InvalidArgumentError("Invalid multimodal request."));
+  auto config = CreateDataProcessorConfigFromLlmModelType(
+      session->session->GetSessionConfig().GetLlmModelType());
+  if (!config.ok()) return error(config.status());
+  auto processor = CreateModelDataProcessor(*config, std::nullopt,
+      &engine->engine->GetTokenizer(),
+      session->session->GetSessionConfig().GetStopTokenIds(), false);
+  if (!processor.ok()) return error(processor.status());
+  auto content = nlohmann::ordered_json::array();
+  std::string prompt = "<|turn>user\n";
+  if (image_path && image_path[0]) {
+    content.push_back({{"type", "image"}, {"path", image_path}});
+    prompt += "\n\n<|image|>\n\n";
+  }
+  if (audio_path && audio_path[0]) {
+    content.push_back({{"type", "audio"}, {"path", audio_path}});
+    prompt += "<|audio|>";
+  }
+  content.push_back({{"type", "text"}, {"text", text}});
+  prompt += text;
+  prompt += "<turn|>\n<|turn>model\n";
+  auto messages = nlohmann::ordered_json::array();
+  messages.push_back({{"role", "user"}, {"content", std::move(content)}});
+  auto inputs = (*processor)->ToInputDataVector(prompt, messages, std::monostate{});
+  if (!inputs.ok()) return error(inputs.status());
+  auto response = session->session->GenerateContent(std::move(*inputs));
+  if (!response.ok()) return error(response.status());
+  return new LiteRtLmResponses{std::move(*response)};
+}
+
+extern "C" LITERT_LM_C_API_EXPORT LiteRtLmResponses*
+ghost_session_debug(LiteRtLmSession* session, const char* request) {
+  if(!session||!session->session) {
+    litert::lm::c::SetLastError(absl::InvalidArgumentError("No active session."));
+    return nullptr;
+  }
+  auto snapshot=session->session->GetGhostDebugJson(request);
+  if(!snapshot.ok()){litert::lm::c::SetLastError(snapshot.status());return nullptr;}
+  return new LiteRtLmResponses{litert::lm::Responses(litert::lm::TaskState::kDone, std::vector<std::string>{*snapshot})};
+}
+
+namespace {
+absl::StatusOr<litert::lm::InputImage> GhostFixedImage(const char* path,
+                                                      bool qwen) {
+  std::ifstream stream(path, std::ios::binary);
+  if (!stream) return absl::InvalidArgumentError("Cannot read image attachment.");
+  std::string bytes((std::istreambuf_iterator<char>(stream)),
+                    std::istreambuf_iterator<char>());
+  auto preprocessor = litert::support::ImagePreprocessor::Create();
+  litert::support::ImagePreprocessParameter params;
+  params.SetTargetDimensions(litert::Dimensions({1, 448, 448, 3}));
+  params.SetNormalizationConfig(qwen
+      ? litert::support::ImagePreprocessParameter::NormalizationConfig{
+            {0.5f, 0.5f, 0.5f}, {0.5f, 0.5f, 0.5f}, 1.0f / 255.0f}
+      : litert::support::ImagePreprocessParameter::NormalizationConfig{
+            {0.48145466f, 0.4578275f, 0.40821073f},
+            {0.26862954f, 0.26130258f, 0.27577711f}, 1.0f / 255.0f});
+  auto image = preprocessor->Preprocess(litert::lm::InputImage(std::move(bytes)), params);
+  if (!image.ok()) return image.status();
+  auto tensor = image->GetPreprocessedImageTensor();
+  if (!tensor.ok()) return tensor.status();
+  std::vector<float> rgb(448 * 448 * 3), planar(rgb.size());
+  auto source = (*tensor)->Duplicate();
+  if (!source) return absl::InternalError("Cannot reference preprocessed image.");
+  auto read = source->Read<float>(absl::MakeSpan(rgb));
+  if (!read) return absl::InternalError("Cannot read preprocessed image.");
+  for (size_t i = 0; i < 448 * 448; ++i)
+    for (size_t c = 0; c < 3; ++c) planar[c * 448 * 448 + i] = rgb[i * 3 + c];
+  auto nchw = litert::TensorBuffer::CreateManagedHostMemory(
+      litert::MakeRankedTensorType<float>({1, 3, 448, 448}), planar.size() * sizeof(float));
+  if (!nchw) return absl::InternalError("Cannot allocate image tensor.");
+  if (!nchw->Write<float>(absl::MakeConstSpan(planar)))
+    return absl::InternalError("Cannot prepare image tensor.");
+  return litert::lm::InputImage(std::move(*nchw));
+}
+}  // namespace
+
+// Fixed-resolution Qwen/Ministral bundles use NCHW vision encoders and do not
+// declare a generic multimodal processor in their metadata. Feed preprocessed
+// images through the existing Session; retain no Conversation or message list.
+extern "C" LITERT_LM_C_API_EXPORT LiteRtLmResponses*
+ghost_session_generate_vl(LiteRtLmEngine* engine, LiteRtLmSession* session,
+                          const char* text, const char* image_path, int profile) {
+  using namespace litert::lm;
+  auto error = [](const absl::Status& status) -> LiteRtLmResponses* {
+    litert::lm::c::SetLastError(status); return nullptr;
+  };
+  if (!engine || !engine->engine || !session || !session->session || !text ||
+      (profile != 0 && profile != 1))
+    return error(absl::InvalidArgumentError("Invalid vision request."));
+  const bool qwen = profile == 0;
+  std::vector<InputData> inputs;
+  std::string prefix = qwen ? "<|im_start|>user\n" : "[INST]";
+  if (image_path && image_path[0]) {
+    if (qwen) prefix += "<|vision_start|>";
+    inputs.emplace_back(InputText(std::move(prefix)));
+    auto image = GhostFixedImage(image_path, qwen);
+    if (!image.ok()) return error(image.status());
+    inputs.emplace_back(std::move(*image));
+    prefix = qwen ? "<|vision_end|>" : "[IMG_END]";
+  }
+  prefix += text;
+  prefix += qwen
+      ? "<|im_end|>\n<|im_start|>assistant\n<think>\n\n</think>\n\n"
+      : "[/INST]";
+  inputs.emplace_back(InputText(std::move(prefix)));
+  auto response = session->session->GenerateContent(std::move(inputs));
+  if (!response.ok()) return error(response.status());
+  return new LiteRtLmResponses{std::move(*response)};
+}
+
+// Avoid keeping every separately compiled prefill program resident on the NPU.
+extern "C" LITERT_LM_C_API_EXPORT void
+ghost_settings_select_compact_signatures(LiteRtLmEngineSettings* settings, const char* prefill) {
+  if (settings && settings->settings)
+    settings->settings->GetMutableMainExecutorSettings().SetSelectedSignatures(
+        std::string(prefill) == "decode"
+            ? std::vector<std::string>{"decode"}
+            : std::vector<std::string>{prefill, "decode"});
+}
